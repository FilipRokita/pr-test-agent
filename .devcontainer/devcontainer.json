// Dev container for Taskly (FastAPI backend + React frontend), modelled on the Tapisode setup.
{
	"name": "Taskly (Python + Node)",
	"image": "mcr.microsoft.com/devcontainers/python:3.12-trixie",

	"features": {
		// Node 24 for the frontend (Python 3.12, same as backend/Dockerfile, comes with the image).
		"ghcr.io/devcontainers/features/node:2": { "version": "24" },
		"ghcr.io/devcontainers/features/github-cli:1": {},
		// Lets the README's `docker compose up` work inside the container.
		// Moby packages are not available on Debian trixie, so install Docker CE.
		"ghcr.io/devcontainers/features/docker-in-docker:4": { "moby": false }
	},

	// UTC, like the production containers.
	"containerEnv": { "TZ": "UTC" },

	// 5173 Vite dev server, 6006 Storybook, 8000 FastAPI, 8080 app from docker compose.
	"forwardPorts": [5173, 6006, 8000, 8080],

	"postCreateCommand": "bash .devcontainer/setup.sh",

	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"esbenp.prettier-vscode",
				"mtxr.sqltools",
				"mtxr.sqltools-driver-pg"
			],
			"settings": {
				"python.defaultInterpreterPath": "${containerWorkspaceFolder}/backend/.venv/bin/python",
				"python.testing.pytestEnabled": true,
				"python.testing.cwd": "${containerWorkspaceFolder}/backend",
				"editor.defaultFormatter": "esbenp.prettier-vscode"
			}
		}
	},

	"remoteUser": "root"
}