+import { Badge, Text } from '../../../design-system'
+import { useTodoCounts } from '../hooks/useTodoCounts'
+import type { Todo } from '../types'
+
+export function TodoCounts({ todos }: { todos: Todo[] }) {
+  const { total, active, completed } = useTodoCounts(todos)
+  if (total === 0) return null
+  return (
+    <div className="row compact" aria-label="Task counts">
+      <Text as="span" muted size="small">
+        {total} {total === 1 ? 'task' : 'tasks'}
+      </Text>
+      <Badge variant="info">{active} to do</Badge>
+      <Badge variant="success">{completed} completed</Badge>
+    </div>
+  )
+}
diff --git a/frontend/src/features/todos/hooks/useTodoCounts.ts b/frontend/src/features/todos/hooks/useTodoCounts.ts
