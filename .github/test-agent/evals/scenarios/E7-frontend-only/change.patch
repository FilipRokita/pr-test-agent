index 0000000..a851de5
--- /dev/null
+++ b/frontend/src/features/todos/hooks/useTodoCounts.ts
@@ -0,0 +1,13 @@
+import { useMemo } from 'react'
+import type { Todo } from '../types'
+
+export function useTodoCounts(todos: Todo[]) {
+  return useMemo(() => {
+    const completed = todos.filter((todo) => todo.completed).length
+    return {
+      total: todos.length,
+      completed,
+      active: todos.length - completed,
+    }
+  }, [todos])
+}
